#!/usr/bin/env python3
"""Print standing graph status for the current project."""

from __future__ import annotations

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "hooks"))
from graph_status import find_project_root, graph_context_block, graph_status  # noqa: E402


def main() -> None:
    project = find_project_root(Path.cwd())
    st = graph_status(project)
    print(f"project: {project}")
    print(f"understand-anything: {st['understand_anything']} {st['understand_path']}")
    print(f"codemap-py: {st['codemap']} {st['codemap_path']}")
    print()
    print(graph_context_block(project))


if __name__ == "__main__":
    main()
