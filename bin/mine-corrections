#!/usr/bin/env python3
"""Optional bulk importer: mine correction-like user turns from local Cursor
agent-transcripts INTO the corrections inbox.

This is the historical counterpart to the live capture hook. It does NOT upsert
principles and has no hardcoded templates — it only appends raw correction rows
to ``docs/memory/mining/corrections-inbox.jsonl`` using the SAME transparent
detector as the capture hook. Generalizing those rows into approved principles is
the job of the ``/alex-mine-corrections`` flush skill (LLM pass, user-approved).

Local-only; secrets are redacted before anything is written.
"""

from __future__ import annotations

import argparse
import hashlib
import json
import re
import sys
from pathlib import Path

_BIN = Path(__file__).resolve().parent
sys.path.insert(0, str(_BIN))
sys.path.insert(0, str(_BIN.parent / "hooks"))
import _memory as mem  # noqa: E402
from capture_correction import THRESHOLD, score_correction  # noqa: E402

CURSOR_PROJECTS = Path.home() / ".cursor" / "projects"
SKIP_SUBAGENTS = True


def iter_transcripts(root: Path, workspace: str | None) -> list[Path]:
    if not root.exists():
        return []
    paths: list[Path] = []
    for proj in sorted(root.iterdir()):
        if not proj.is_dir():
            continue
        if workspace and workspace not in proj.name:
            continue
        tdir = proj / "agent-transcripts"
        if not tdir.is_dir():
            continue
        for p in tdir.rglob("*.jsonl"):
            if SKIP_SUBAGENTS and "subagents" in p.parts:
                continue
            paths.append(p)
    return paths


def user_query_body(text: str) -> str:
    m = re.search(r"<user_query>\s*(.*?)\s*</user_query>", text, re.S | re.I)
    body = (m.group(1) if m else text).strip()
    body = re.sub(r"<timestamp>.*?</timestamp>", "", body, flags=re.S)
    return body.strip()


def extract_user_texts(jsonl_path: Path) -> list[tuple[str, str]]:
    conv = jsonl_path.stem
    out: list[tuple[str, str]] = []
    try:
        for line in jsonl_path.read_text(encoding="utf-8", errors="replace").splitlines():
            if not line.strip():
                continue
            try:
                obj = json.loads(line)
            except json.JSONDecodeError:
                continue
            if obj.get("role") != "user":
                continue
            msg = obj.get("message") or {}
            content = msg.get("content")
            texts: list[str] = []
            if isinstance(content, str):
                texts.append(content)
            elif isinstance(content, list):
                for part in content:
                    if isinstance(part, dict) and part.get("type") == "text":
                        texts.append(str(part.get("text", "")))
                    elif isinstance(part, str):
                        texts.append(part)
            for t in texts:
                body = user_query_body(t)
                if len(body) < 8 or len(body) > 2000:
                    continue
                if "tool_use" in body and body.lstrip().startswith("{"):
                    continue
                out.append((conv, body))
    except OSError:
        return []
    return out


def normalize_quote(text: str) -> str:
    return re.sub(r"\s+", " ", mem.redact(text)).strip()[:400]


def append_inbox(inbox: Path, rows: list[dict]) -> None:
    inbox.parent.mkdir(parents=True, exist_ok=True)
    with inbox.open("a", encoding="utf-8") as f:
        for r in rows:
            f.write(json.dumps(r, ensure_ascii=False) + "\n")


def main() -> None:
    ap = argparse.ArgumentParser(description="Bulk-import Cursor corrections into the inbox")
    ap.add_argument("--workspace", default="", help="Substring filter on ~/.cursor/projects/<name>")
    ap.add_argument("--limit", type=int, default=200, help="Max corrections to import")
    ap.add_argument(
        "--transcripts-root",
        type=Path,
        default=CURSOR_PROJECTS,
        help="Cursor projects dir (default: ~/.cursor/projects).",
    )
    ap.add_argument(
        "--root",
        type=Path,
        default=None,
        help="Memory project root (or docs/memory). Same as other CLIs / ALEXS_RIG_MEMORY.",
    )
    ap.add_argument(
        "--since",
        default="",
        help="Only scan transcript files modified on/after this date (YYYY-MM-DD).",
    )
    args = ap.parse_args()
    mem.apply_root_arg(args)
    mem.ensure_layout()

    inbox = mem.MEMORY / "mining" / "corrections-inbox.jsonl"
    paths = iter_transcripts(args.transcripts_root, args.workspace or None)
    if args.since:
        from datetime import datetime, timezone

        try:
            since_dt = datetime.strptime(args.since, "%Y-%m-%d").replace(tzinfo=timezone.utc)
        except ValueError as exc:
            raise SystemExit(f"--since must be YYYY-MM-DD: {exc}") from exc
        since_ts = since_dt.timestamp()
        paths = [p for p in paths if p.stat().st_mtime >= since_ts]

    seen: set[str] = {
        hashlib.sha1(str(r.get("text", "")).encode()).hexdigest()[:12]
        for r in mem.read_jsonl(inbox)
    }
    rows: list[dict] = []
    for path in paths:
        ws = path.parts[path.parts.index("projects") + 1] if "projects" in path.parts else "?"
        for conv, text in extract_user_texts(path):
            score, signals = score_correction(text)
            if score < THRESHOLD:
                continue
            quote = normalize_quote(text)
            if len(quote) < 8:
                continue
            digest = hashlib.sha1(quote.encode()).hexdigest()[:12]
            if digest in seen:
                continue
            seen.add(digest)
            rows.append(
                {
                    "ts": mem.utc_now(),
                    "text": quote,
                    "score": score,
                    "signals": signals,
                    "source": "mine-corrections",
                    "conversation": conv,
                    "workspace": ws,
                }
            )
            if len(rows) >= args.limit:
                break
        if len(rows) >= args.limit:
            break

    append_inbox(inbox, rows)

    print(f"transcripts scanned: {len(paths)}")
    print(f"corrections imported: {len(rows)} → {inbox}")
    print("Review + promote to principles with /alex-mine-corrections (nothing reaches L0 without approval).")
    if not paths:
        print(
            f"NOTE: 0 transcripts under {args.transcripts_root} — importer OK but empty "
            "(needs local Cursor ~/.cursor/projects on this host). Not broken.",
            file=sys.stderr,
        )


if __name__ == "__main__":
    main()
