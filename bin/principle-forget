#!/usr/bin/env python3
"""Forget (archive) a principle by id."""

from __future__ import annotations

import argparse
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import _memory as mem  # noqa: E402


def main() -> None:
    p = argparse.ArgumentParser()
    p.add_argument("--id", required=True)
    p.add_argument("--reason", default="forgotten")
    mem.add_root_arg(p)
    args = p.parse_args()
    mem.apply_root_arg(args)
    ok = mem.archive_row(mem.MEMORY / "PRINCIPLES.jsonl", "PRINCIPLES.jsonl", args.id, reason=args.reason)
    if not ok:
        raise SystemExit(f"principle not found: {args.id}")
    print(f"forgot {args.id} → {mem.regen_l0()}")


if __name__ == "__main__":
    main()
